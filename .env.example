PORT=8080
DB_PATH=data/strength_tracker.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=change-me-in-production
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
CLOUDFLARE_EMAIL_TOKEN=
PUBLIC_URL=

# --- Coach (AI features, all required) ---
# Startup hard-fails if any is empty. Base URL and model are
# stated explicitly per deploy rather than defaulted.
CLOUDFLARE_AI_ACCOUNT_ID=<account id>
CLOUDFLARE_AI_TOKEN=<api token>
AI_BASE_URL=https://api.cloudflare.com/client/v4
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
