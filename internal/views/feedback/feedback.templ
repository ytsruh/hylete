package feedback

import (
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// FeedbackPage renders the user-facing feedback submission form.
// The web app is otherwise read-only; this page exists so users
// can get in touch (e.g. to request access to the iOS app) and
// every submission lands in the admin feedback inbox
// (/admin/feedback) via FeedbackController.Submit — the same
// controller the iOS client's POST /api/v1/feedback uses, so
// both surfaces enforce identical validation rules.
templ FeedbackPage(userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Submit Feedback", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Submit Feedback"})
		<p class="text-muted-foreground mb-6">Have feedback or found a bug? Let us know!</p>
		<form
			id="feedback-form"
			hx-post="/feedback"
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6 max-w-[600px]"
		>
			<fieldset class="grid gap-4">
				<div class="grid gap-2">
					<label for="title">Title</label>
					<input
						class="input"
						type="text"
						id="title"
						name="title"
						placeholder="Brief summary of your feedback"
						required
					/>
					<p class="text-sm text-muted-foreground">5-100 characters</p>
				</div>
				<div class="grid gap-2">
					<label for="message">Message</label>
					<textarea
						id="message"
						name="message"
						class="textarea"
						placeholder="Please describe your feedback in detail..."
						rows="6"
						required
					></textarea>
					<p class="text-sm text-muted-foreground">10-1000 characters</p>
				</div>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#feedback-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center gap-2 justify-between">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Submit
					</span>
					<span id="feedback-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
			</div>
		</form>
		// Page-scoped success handler: the POST response carries an
		// HX-Trigger for this event, which clears the form so the
		// user can't accidentally resubmit the same text. Scoped to
		// this page rather than the global layout because only the
		// feedback form has a #feedback-form element.
		<script>
			document.body.addEventListener('feedbackSubmitted', function() {
				var form = document.getElementById('feedback-form');
				if (form) { form.reset(); }
			});
		</script>
	}
}

// FeedbackFormSuccess shows success message
templ FeedbackFormSuccess(message string) {
	@views.Toast("success", "Success", message)
}

// FeedbackFormError shows validation errors
templ FeedbackFormError(message string) {
	@views.Toast("error", "Error", message)
}
