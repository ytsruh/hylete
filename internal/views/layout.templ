package views

import "hylete/internal/models"
import "hylete/internal/views/components"

type PageData struct {
	Title           string
	ExerciseEntries []models.ExerciseEntry
	Exercises       []models.Exercise
	ExerciseEntry   *models.ExerciseEntry
	UserName        string
	IsAuthenticated bool
	IsAdmin         bool
	CurrentPath     string
}

// Layout is the base layout for all pages
templ Layout(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="theme-color" content="#4a5568"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Hylete"/>
			<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="manifest" href="/manifest.json"/>
			<title>{ data.Title } - Hylete</title>
			<script>
				(() => {
					try {
						const stored = localStorage.getItem('themeMode');
						if (stored ? stored === 'dark'
									: matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						}
					} catch (_) {}

					const apply = dark => {
						document.documentElement.classList.toggle('dark', dark);
						try { localStorage.setItem('themeMode', dark ? 'dark' : 'light'); } catch (_) {}
					};

					document.addEventListener('basecoat:theme', (event) => {
						const mode = event.detail?.mode;
						apply(mode === 'dark' ? true
								: mode === 'light' ? false
								: !document.documentElement.classList.contains('dark'));
					});
				})();
			</script>
			<link rel="stylesheet" href="/css/styles.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			// Pin htmx 1.x defaults we rely on. htmx 2 flipped
			// `scrollBehavior` from "smooth" to "auto"; the
			// exercise-history pagination uses `hx-push-url="true"`
			// so restoring the v1 behaviour keeps the page-change
			// animation identical to today.
			<script>
				if (window.htmx) {
					htmx.config.scrollBehavior = 'smooth';
				}
			</script>
			<script src="/js/basecoat.js" defer></script>
		</head>
		<body>
			if data.IsAuthenticated {
				<aside id="sidebar" class="sidebar" data-side="left" aria-hidden="false">
					<nav aria-label="Sidebar navigation">
						<header class="border-sidebar-border">
							<div class="flex items-center px-2 gap-2">
								<div class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg font-bold">H</div>
								<span class="font-semibold text-sidebar-foreground truncate">Hylete</span>
							</div>
						</header>
						<section class="flex flex-col gap-y-5 py-5 pl-2 pr-3">
							<div>
								<h3>Exercise</h3>
								<ul>
									<li>
										<a
											href="/dashboard"
											if data.CurrentPath == "/dashboard" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "home", Size: 18})
											<span>Dashboard</span>
										</a>
									</li>
									<li>
										<a
											href="/exercises"
											if data.CurrentPath == "/exercises" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "dumbbell", Size: 18})
											<span>Exercises</span>
										</a>
									</li>
								</ul>
							</div>
							if data.IsAdmin {
								<div>
									<h3>Admin</h3>
									<ul>
										<li>
											<a
												href="/admin/exercises"
												if data.CurrentPath == "/admin/exercises" {
													aria-current="page"
												}
											>
												@components.Icon(components.IconProps{Name: "dumbbell", Size: 18})
												<span>Exercises</span>
											</a>
										</li>
										<li>
											<a
												href="/admin/users"
												if data.CurrentPath == "/admin/users" {
													aria-current="page"
												}
											>
												@components.Icon(components.IconProps{Name: "user", Size: 18})
												<span>Users</span>
											</a>
										</li>
										<li>
											<a
												href="/admin/feedback"
												if data.CurrentPath == "/admin/feedback" {
													aria-current="page"
												}
											>
												@components.Icon(components.IconProps{Name: "message", Size: 18})
												<span>Feedback</span>
											</a>
										</li>
									</ul>
								</div>
							}
							<div>
								<h3>Account</h3>
								<ul>
									<li>
										<a
											href="/profile"
											if data.CurrentPath == "/profile" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "user", Size: 18})
											<span>Profile</span>
										</a>
									</li>
									<li>
										<a
											href="/export"
											if data.CurrentPath == "/export" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "download", Size: 18})
											<span>Data Export</span>
										</a>
									</li>
									<li>
										<a
											href="/feedback"
											if data.CurrentPath == "/feedback" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "message", Size: 18})
											<span>Feedback</span>
										</a>
									</li>
									<li>
										<form
											hx-post="/logout"
											hx-target="#toaster"
											hx-swap="beforeend"
											hx-indicator="#logout-spinner"
										>
											<button type="submit" class="hover:cursor-pointer flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground active:bg-sidebar-accent active:text-sidebar-accent-foreground [&>svg]:size-4 [&>svg]:shrink-0">
												<span class="btn-text flex items-center gap-2">
													@components.Icon(components.IconProps{Name: "log-out", Size: 18})
													<span class="truncate">Logout</span>
												</span>
												<span id="logout-spinner" class="htmx-indicator flex items-center justify-center animate-spin">
													@components.Icon(components.IconProps{Name: "loader", Size: 18})
												</span>
											</button>
										</form>
									</li>
								</ul>
							</div>
						</section>
					</nav>
				</aside>
			}
			<main>
				<header class="relative z-50">
					<nav class="sticky top-0 z-50 flex items-center gap-4 px-3 md:px-4 py-2 bg-background border-b">
						<ul class="w-full flex justify-between list-none m-0 p-0 items-center">
							if data.IsAuthenticated {
								<div class="flex items-center gap-1">
									<li>
										<button type="button" onclick="document.getElementById('sidebar')?.toggle()" class="btn-ghost" aria-label="Toggle sidebar">
											@components.Icon(components.IconProps{Name: "menu", Size: 20})
										</button>
									</li>
									<a href="/dashboard"><li class="flex lg:hidden text-primary">Hylete</li></a>
								</div>
								<div class="flex items-center gap-2">
									<button
										type="button"
										aria-label="Toggle dark mode"
										onclick="window.basecoat.theme.toggle()"
										class="btn size-8"
										data-variant="outline"
										data-size="icon"
									>
										<span class="hidden dark:block">@components.Icon(components.IconProps{Name: "sun", Size: 16})
</span>
										<span class="block dark:hidden">@components.Icon(components.IconProps{Name: "moon", Size: 16})
</span>
									</button>
								</div>
							} else {
								<div class="w-full flex items-center justify-between gap-2">
									<a class="flex items-center px-2 gap-2" href="/">
										<div class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg font-bold">H</div>
										<span class="font-bold text-sidebar-foreground truncate">Hylete</span>
									</a>
									// Desktop: full inline nav (md+). Keeps existing desktop look 1:1.
									<div class="hidden md:flex items-center gap-2">
										<a href="/" class="btn-ghost">Home</a>
										<a href="/#features" class="btn-ghost">Features</a>
										<a href="/login" class="btn" data-variant="outline" data-size="sm">Login</a>
										<a href="/register" class="btn" data-size="sm">Sign Up</a>
										<button
											type="button"
											aria-label="Toggle dark mode"
											onclick="window.basecoat.theme.toggle()"
											class="btn size-8"
											data-variant="outline"
											data-size="icon"
										>
											<span class="hidden dark:block">@components.Icon(components.IconProps{Name: "sun", Size: 16})
</span>
											<span class="block dark:hidden">@components.Icon(components.IconProps{Name: "moon", Size: 16})
</span>
										</button>
									</div>
									// Mobile: compact — theme toggle + Basecoat dropdown-menu containing all nav links.
									<div class="flex md:hidden items-center gap-1.5">
										<button
											type="button"
											aria-label="Toggle dark mode"
											onclick="window.basecoat.theme.toggle()"
											class="btn size-8"
											data-variant="outline"
											data-size="icon"
										>
											<span class="hidden dark:block">@components.Icon(components.IconProps{Name: "sun", Size: 16})
</span>
											<span class="block dark:hidden">@components.Icon(components.IconProps{Name: "moon", Size: 16})
</span>
										</button>
										<div class="dropdown-menu">
											<button type="button" aria-label="Open menu" class="btn size-8" data-variant="ghost" data-size="icon">
												@components.Icon(components.IconProps{Name: "menu", Size: 20})
											</button>
											<div data-popover data-align="end" class="min-w-52">
												<div role="menu" class="flex flex-col gap-1">
													<a role="menuitem" href="/">Home</a>
													<a role="menuitem" href="/#features">Features</a>
													<div role="separator"></div>
													<a role="menuitem" href="/login">Login</a>
													<a role="menuitem" href="/register" class="font-medium">Sign Up</a>
												</div>
											</div>
										</div>
									</div>
								</div>
							}
						</ul>
					</nav>
				</header>
				<div class="container mx-auto max-w-5xl px-4 py-4 md:py-8">
					{ children... }
				</div>
			</main>
			if !data.IsAuthenticated {
				<footer class="border-t">
					<div class="container mx-auto max-w-5xl px-3 md:px-4 py-4 md:py-6 flex flex-col items-center gap-2 md:gap-3 text-sm md:flex-row md:justify-between">
						<div class="flex items-center gap-2 text-muted-foreground">
							<div class="bg-primary text-primary-foreground flex size-6 shrink-0 items-center justify-center rounded-md text-xs font-bold">H</div>
							<span>© 2026 Hylete</span>
						</div>
						<nav class="flex items-center gap-4 md:gap-5 text-muted-foreground">
							<a href="/" class="hover:text-foreground transition-colors py-1">Home</a>
							<a href="/showcase" class="hover:text-foreground transition-colors py-1">Showcase</a>
							<a href="/register" class="hover:text-foreground transition-colors py-1">Sign up</a>
							<a href="/login" class="hover:text-foreground transition-colors py-1">Login</a>
						</nav>
					</div>
				</footer>
			}
			<dialog id="confirm-dialog" class="dialog w-full sm:max-w-106.25" onclick="if(event.target===this)this.close()">
				<form method="dialog">
					<header>
						<h3>Confirm</h3>
						<p id="confirm-message"></p>
					</header>
					<footer class="flex items-center gap-3">
						<button type="button" commandfor="confirm-dialog" command="close" class="btn-outline">Cancel</button>
						{{
							/*
								The OK button defaults to `btn-destructive`
								(red) because confirmations can be
								destructive (e.g. "Remove this image? It
								will be deleted when you save."). Callers
								whose action is a normal workflow step —
								not a deletion — opt into the brand-orange
								`btn-primary` styling with
								data-confirm-variant="primary" on the
								element that carries hx-confirm (the
								htmx:confirm handler below swaps the class
								before showModal and the dialog's close
								handler restores the red default so the
								next opener — including the JS-driven
								openConfirm in
								internal/views/components/image_upload.templ
								— always starts from the destructive
								default).
							*/
						}}
						<button type="button" id="confirm-ok" value="confirm" hx-indicator="#confirm-spinner, self" class="btn-destructive relative inline-flex">
							<span class="btn-text">Confirm</span>
							<span id="confirm-spinner" class="htmx-indicator flex items-center justify-center animate-spin">
								@components.Icon(components.IconProps{Name: "loader", Size: 18})
							</span>
						</button>
					</footer>
				</form>
			</dialog>
			<script>
				// confirm-ok classes are swapped per opener: destructive
				// (red) is the default; an hx-confirm element with
				// data-confirm-variant="primary" gets the brand orange.
				// The dialog's close handler restores the default so a
				// JS-driven opener (image upload's openConfirm) never
				// inherits an orange left behind by a previous htmx
				// confirmation.
				var CONFIRM_OK_DEFAULT_CLASS = 'btn-destructive';
				var CONFIRM_OK_VARIANTS = ['btn-destructive', 'btn-primary'];
				function setConfirmOkVariant(variant) {
					var okBtn = document.getElementById('confirm-ok');
					if (!okBtn) return;
					CONFIRM_OK_VARIANTS.forEach(function(cls) { okBtn.classList.remove(cls); });
					okBtn.classList.add(variant === 'primary' ? 'btn-primary' : CONFIRM_OK_DEFAULT_CLASS);
				}
				document.getElementById('confirm-dialog').addEventListener('close', function() {
					setConfirmOkVariant('destructive');
				});
				document.body.addEventListener('htmx:confirm', function(evt) {
					if (!evt.target.hasAttribute('hx-confirm')) return;
					evt.preventDefault();
					var dialog = document.getElementById('confirm-dialog');
					document.getElementById('confirm-message').textContent = evt.detail.question;
					setConfirmOkVariant(evt.target.getAttribute('data-confirm-variant'));
					document.getElementById('confirm-ok').onclick = function() {
						evt.detail.issueRequest(true);
					};
					dialog.showModal();
				});
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					var dialog = document.getElementById('confirm-dialog');
					if (dialog.open) {
						dialog.close();
					}
				});
				// Server handlers that respond to an htmx call with a
				// redirect (login, register, logout, admin save) send
				// the response as a toast fragment plus an HX-Trigger
				// header shaped {"triggerRedirect": "/target"}. htmx
				// turns that header into a browser event named
				// triggerRedirect carrying the URL in detail.value —
				// this listener is what actually navigates. The short
				// delay lets the success toast render and be seen
				// before the page changes.
				document.body.addEventListener('triggerRedirect', function(evt) {
					var target = evt.detail && evt.detail.value;
					if (!target) return;
					setTimeout(function() { window.location.href = target; }, 600);
				});
				// showToast clones the hidden <template> rendered
				// above (toastTemplate) for the given category, fills
				// in the title and description, and appends the clone
				// to #toaster. The icon SVGs and toast structure live
				// in one place (this layout) so widgets don't
				// duplicate them. Falls back to the "default" template
				// if the requested category isn't present. Global so
				// any widget can raise a toast from client-side code
				// (e.g. the photo upload widget, which uploads
				// directly to R2 via a presigned URL and so can't
				// piggy-back its toast onto an htmx response).
				window.showToast = function(category, title, message) {
					var toaster = document.getElementById('toaster');
					if (!toaster) return;
					var template = document.getElementById('toast-template-' + category) || document.getElementById('toast-template-default');
					if (!template) return;
					var clone = template.content.cloneNode(true);
					var h2 = clone.querySelector('[data-toast-title]');
					if (h2) h2.textContent = title;
					var p = clone.querySelector('[data-toast-description]');
					if (p) {
						if (message) {
							p.textContent = message;
							p.classList.remove('hidden');
						} else {
							p.remove();
						}
					}
					toaster.appendChild(clone);
				};
			</script>
			<div id="toaster" class="toaster"></div>
			// Hidden toast templates. Widgets that need to render a
			// toast from client-side code (e.g. the weight photo
			// widget, which uploads directly to R2 via a presigned
			// URL and so can't piggy-back its toast onto the upload
			// response) clone the right template and fill in the
			// title/description. The exercise image widget uses the
			// server-rendered views.Toast directly via htmx and
			// doesn't need these. The icon SVGs are defined once
			// here so they don't get duplicated into client-side JS.
			@toastTemplate("success")
			@toastTemplate("error")
			@toastTemplate("warning")
			@toastTemplate("default")
		</body>
	</html>
}

// toastBody renders the shared inner markup of a toast: the icon
// for the category plus the title and optional description. Used by
// both the server-rendered Toast and the hidden toastTemplate
// elements so the markup lives in exactly one place.
//
// title and description are rendered into the <h2> and <p> only
// when non-empty; the data-toast-title / data-toast-description
// attributes are always present so client-side JS that clones the
// template can find the right elements and fill them in (or
// overwrite whatever's there).
templ toastBody(category string, title string, description string) {
	<div class="toast-content">
		if category == "success" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
		} else if category == "error" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
		} else if category == "warning" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
		} else {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="16" y2="12"></line><line x1="12" x2="12.01" y1="8" y2="8"></line></svg>
		}
		<section>
			if title != "" {
				<h2 data-toast-title>{ title }</h2>
			} else {
				<h2 data-toast-title></h2>
			}
			if description != "" {
				<p data-toast-description>{ description }</p>
			} else {
				<p data-toast-description class="hidden"></p>
			}
		</section>
	</div>
}

// toastTemplate renders a hidden <template> element for one toast
// category. The category name becomes the id suffix and the
// data-category attribute. JS clones template.content, fills in
// the title/description, and appends the clone to #toaster.
templ toastTemplate(category string) {
	<template id={ "toast-template-" + category }>
		<div class="toast" role="status" aria-atomic="true" aria-hidden="false" data-category={ category }>
			@toastBody(category, "", "")
		</div>
	</template>
}

// Toast is a notification component using Basecoat toast
templ Toast(category string, title string, description string) {
	<div class="toast" role="status" aria-atomic="true" aria-hidden="false" data-category={ category }>
		@toastBody(category, title, description)
	</div>
}

// EmptyState shows when no exercise entries exist
templ EmptyState() {
	<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
		<header class="flex max-w-sm flex-col items-center gap-3 text-center">
			<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
				@components.Icon(components.IconProps{Name: "dumbbell", Size: 24})
			</div>
			<h3 class="text-lg font-semibold">No workouts in the last 7 days</h3>
			<p class="text-muted-foreground text-sm">Log a session with the Hylete app to keep your streak going.</p>
		</header>
	</div>
}
