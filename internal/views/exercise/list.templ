package exercise

import (
	"fmt"
	"strings"

	"hylete/internal/models"
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// ExercisesList renders a page listing all exercises.
templ ExercisesList(exercises []models.Exercise, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Exercises", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Exercises"})
		</div>
		<div class="mb-6">
			<input
				type="search"
				id="exercise-search"
				placeholder="Search exercises..."
				class="input"
			/>
		</div>
		if len(exercises) == 0 {
			<div class="text-center py-12 text-muted-foreground">
				<p>No exercises available.</p>
			</div>
		} else {
			<table class="table w-full">
				<thead>
					<tr>
						<th>Name</th>
						<th>Type</th>
					</tr>
				</thead>
				<tbody id="exercise-grid">
					for _, exercise := range exercises {
						<tr
							class="exercise-row cursor-pointer hover:bg-muted/50"
							data-name={ strings.ToLower(exercise.Name) }
							data-href={ templ.SafeURL(fmt.Sprintf("/exercises/%s", exercise.ID)) }
						>
							<td>
								<a href={ templ.SafeURL(fmt.Sprintf("/exercises/%s", exercise.ID)) } class="block">
									{ exercise.Name }
								</a>
							</td>
							<td>
								@components.ExerciseTypeBadge(string(exercise.Type))
							</td>
						</tr>
					}
				</tbody>
			</table>
			<div id="no-results" class="hidden text-center py-12 text-muted-foreground">
				<p>No exercises found.</p>
			</div>
		}
		<script>
			(function() {
				const searchInput = document.getElementById('exercise-search');
				const rows = document.querySelectorAll('.exercise-row');
				const noResults = document.getElementById('no-results');
				let debounceTimer;

				rows.forEach(function(row) {
					row.addEventListener('click', function(e) {
						if (e.target.closest('a')) return;
						window.location.href = this.dataset.href;
					});
				});

				searchInput.addEventListener('input', function() {
					clearTimeout(debounceTimer);
					debounceTimer = setTimeout(function() {
						const query = searchInput.value.toLowerCase().trim();
						let visibleCount = 0;

						rows.forEach(function(row) {
							const name = row.getAttribute('data-name');
							if (name.includes(query)) {
								row.classList.remove('hidden');
								visibleCount++;
							} else {
								row.classList.add('hidden');
							}
						});

						noResults.classList.toggle('hidden', visibleCount > 0);
					}, 200);
				});
			})();
		</script>
	}
}
