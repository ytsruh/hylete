package exercise

import (
	"fmt"

	"hylete/internal/models"
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// exerciseNavActiveHistory is the active value for ExerciseNav that
// highlights the History (exercise entries) tab.
const exerciseNavActiveHistory = "history"

// exerciseNavActiveChart is the active value for ExerciseNav that
// highlights the Chart tab.
const exerciseNavActiveChart = "chart"

// exerciseNavActiveAdvanced is the active value for ExerciseNav that
// highlights the Advanced chart tab.
const exerciseNavActiveAdvanced = "advanced"

// ExerciseNav renders a centered button group that lets the user switch
// between the History, Chart, and Advanced views for a single exercise.
//
// The active button is rendered with the primary btn class plus
// aria-current="page" (mirroring the convention used by Layout's sidebar
// nav and HistoryTable's page indicator) so screen readers and styling
// hooks have a consistent way to identify the current sub-view.
//
// The Advanced (reps-vs-weight scatter) link is only rendered for
// non-cardio exercises — the scatter's axes are strength-specific.
templ ExerciseNav(exerciseID string, exerciseType models.ExerciseType, active string) {
	<div class="flex justify-center mb-6">
		<div role="group" class="button-group" aria-label="Exercise views">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/exercises/%s", exerciseID)) }
				if active == exerciseNavActiveHistory {
					class="btn"
					aria-current="page"
				} else {
					class="btn-outline"
				}
			>
				@components.Icon(components.IconProps{Name: "chevron-left", Size: 18})
				Back
			</a>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/exercises/%s/chart", exerciseID)) }
				if active == exerciseNavActiveChart {
					class="btn"
					aria-current="page"
				} else {
					class="btn-outline"
				}
			>
				Chart
			</a>
			if exerciseType != models.ExerciseTypeCardio {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/exercises/%s/chart/advanced", exerciseID)) }
					if active == exerciseNavActiveAdvanced {
						class="btn"
						aria-current="page"
					} else {
						class="btn-outline"
					}
				>
					Advanced
				</a>
			}
		</div>
	</div>
}

// ExerciseChart renders the dedicated chart view for a single exercise:
// a full-width line chart of the user's full workout history for that
// exercise. The view uses the shared Layout and the centered ExerciseNav
// so the user can switch to the History sub-view (and Advanced, for
// strength exercises).
//
// chartExerciseEntries is the user's full set of exercise entries for the
// exercise, fed by ExerciseEntryController.GetAllExerciseEntriesForChart.
// The view aggregates to one point per calendar day — heaviest weight for
// strength, fastest pace for cardio — before plotting. When there are
// fewer than 2 unique days, a friendly empty-state message is rendered in
// place of the chart.
//
// weightUnit and distanceUnit drive the dataset label so the legend
// matches the user's settings; the exercise's type decides which metric
// is plotted.
templ ExerciseChart(exercise *models.Exercise, chartExerciseEntries []models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool, weightUnit string, distanceUnit string) {
	@views.Layout(views.PageData{Title: exercise.Name, UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@ExerciseNav(exercise.ID, exercise.Type, exerciseNavActiveChart)
		<header class="mb-4">
			if exercise.Type == models.ExerciseTypeCardio {
				<h1 class="text-xl font-semibold">{ exercise.Name } Pace Progression</h1>
			} else {
				<h1 class="text-xl font-semibold">{ exercise.Name } Progression</h1>
			}
		</header>
		<div class="card p-4">
			if chartHasEnoughData(chartExerciseEntries) {
				<div class="h-[60vh] min-h-96">
					@components.Chart(chartDataForExerciseFull(chartExerciseEntries, exercise.Name, exercise.Type, weightUnit, distanceUnit))
				</div>
			} else {
				<p class="text-muted-foreground text-center py-12">
					Log at least 2 sessions to see your progression.
				</p>
			}
		</div>
	}
}

// ExerciseChartAdvanced renders the advanced chart view for a single
// exercise: a full-width scatter plot of every set the user has logged,
// with reps on the x axis and weight on the y axis. Each dot is a single
// set and the hover tooltip surfaces the date. The view uses the shared
// Layout and the centered ExerciseNav so the user can switch to the
// History or Chart sub-views.
//
// Cardio exercises never reach the scatter: their entries carry duration
// and distance rather than reps and weight, so a cardio visit renders a
// short explanation in place of the chart. The nav hides the Advanced
// button for cardio too — this branch only guards direct URL access.
//
// weightUnit drives the strength scatter's y-axis label.
templ ExerciseChartAdvanced(exercise *models.Exercise, chartExerciseEntries []models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool, weightUnit string) {
	@views.Layout(views.PageData{Title: exercise.Name, UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@ExerciseNav(exercise.ID, exercise.Type, exerciseNavActiveAdvanced)
		if exercise.Type == models.ExerciseTypeCardio {
			<header class="mb-4">
				<h1 class="text-xl font-semibold">{ exercise.Name }</h1>
			</header>
			<p class="text-muted-foreground text-center py-12">
				The advanced volume view is available for strength exercises only — cardio progress lives on the Chart tab.
			</p>
		} else {
			<header class="mb-4">
				<h1 class="text-xl font-semibold">{ exercise.Name } Volume</h1>
			</header>
			<div class="card p-4">
				if chartScatterHasEnoughData(chartExerciseEntries) {
					<div class="h-[60vh] min-h-96">
						@components.ScatterChart(chartDataForExerciseScatter(chartExerciseEntries, exercise.Name, "Every set plotted by reps and weight", weightUnit))
					</div>
				} else {
					<p class="text-muted-foreground text-center py-12">
						Log at least 2 sets to see your volume profile.
					</p>
				}
			</div>
		}
	}
}

// chartHasEnoughData reports whether the given exercise entry slice has at
// least 2 unique calendar days of data — the threshold Chart.js needs to
// draw a meaningful line. Multiple sets on the same day collapse to one
// point.
func chartHasEnoughData(exerciseEntries []models.ExerciseEntry) bool {
	seen := make(map[string]struct{})
	for _, e := range exerciseEntries {
		key := e.CreatedAt.Format("2006-01-02")
		seen[key] = struct{}{}
	}
	return len(seen) >= 2
}

// chartScatterHasEnoughData reports whether the given exercise entry slice
// has at least 2 sets to plot on the scatter chart. Unlike
// chartHasEnoughData the scatter view does NOT collapse by day — every
// set is a dot, so the threshold is just len(exerciseEntries) >= 2.
func chartScatterHasEnoughData(exerciseEntries []models.ExerciseEntry) bool {
	return len(exerciseEntries) >= 2
}

// chartDataForExerciseFull aggregates a user's full exercise entry set for
// a single exercise into the Chart.js line/area series used by the
// dedicated /chart view. Exercise entries are grouped by calendar day and
// reduced to one point per day — heaviest weight for strength exercises,
// fastest pace (seconds per kilometre) for cardio exercises — so the line
// reads as a PR-over-time view rather than a noisy per-set series. Days
// are sorted ascending so the line runs left-to-right.
//
// Unlike the small chart on the History view (see chartDataForExercise
// in history.templ), this helper:
//   - is fed the full exercise entry set, not a 30-entry slice
//   - uses a distinct canvas id (`exercise-chart`) so the History view's
//     smaller chart and the full-width chart can never collide if both
//     are ever loaded on the same page
//   - does NOT hide the axis tick labels — the full-width layout has
//     room to render them legibly
//
// weightUnit and distanceUnit drive the dataset label; exerciseType
// decides which metric is plotted.
func chartDataForExerciseFull(exerciseEntries []models.ExerciseEntry, exerciseName string, exerciseType models.ExerciseType, weightUnit string, distanceUnit string) components.ChartProps {
	var days []chartDay
	title := "Max weight per training day"
	if exerciseType == models.ExerciseTypeCardio {
		days = aggregateExerciseEntriesPaceByDay(exerciseEntries)
		title = "Fastest pace per training day"
	} else {
		days = aggregateExerciseEntriesByDay(exerciseEntries)
	}
	labels, values := dayLabelsAndValues(days, "02 Jan")
	return components.ChartProps{
		ID:     "exercise-chart",
		Title:  title,
		Labels: labels,
		Datasets: []components.ChartDataset{
			{Label: chartDatasetLabel(exerciseName, exerciseType, weightUnit, distanceUnit), Values: values},
		},
	}
}

// chartDataForExerciseScatter converts a user's full exercise entry set
// for a single exercise into the Chart.js scatter series used by the
// dedicated /chart/advanced view. Unlike chartDataForExerciseFull the
// scatter view does NOT collapse by day — every set is its own (reps,
// weight) point so the user can see set-by-set volume patterns. The date
// is carried alongside each point and surfaced in the hover tooltip.
//
// Exercise entries are NOT sorted — the scatter chart does not need them
// in any particular order, and Chart.js positions points by (x, y)
// regardless of array order. A distinct canvas id
// (`exercise-chart-advanced`) keeps it from colliding with the line chart
// on the /chart view. The chart does not hide axis tick labels — the
// full-width layout has room for them, and integer rep ticks help the
// user read set counts at a glance.
//
// weightUnit is the user's preferred unit ("kg" / "lbs") and drives the
// y-axis label.
func chartDataForExerciseScatter(exerciseEntries []models.ExerciseEntry, exerciseName string, chartTitle string, weightUnit string) components.ScatterChartProps {
	points := make([]components.ScatterPoint, 0, len(exerciseEntries))
	for _, e := range exerciseEntries {
		points = append(points, components.ScatterPoint{
			X:    float64(e.Reps),
			Y:    e.Weight,
			Date: e.CreatedAt.Format("02 Jan"),
		})
	}
	return components.ScatterChartProps{
		ID:     "exercise-chart-advanced",
		Title:  chartTitle,
		XLabel: "Reps",
		YLabel: fmt.Sprintf("%s (%s)", exerciseName, weightUnit),
		Points: points,
	}
}
