package exercise

import (
	"fmt"
	"hylete/internal/models"
	"hylete/internal/utils"
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// historyTableWrapID is the id of the swappable region around the history
// table. The htmx-driven pagination controls swap this region's outerHTML
// on each page change.
const historyTableWrapID = "history-table-wrap"

// historySpinnerID is the id of the htmx indicator shown while a page loads.
const historySpinnerID = "history-spinner"

// ExerciseHistory renders the full exercise history page, including the
// header, lifetime stats, the progression chart (max weight for strength,
// fastest pace for cardio), and the paginated table. The pagination controls
// swap only the table region via htmx.
//
// The hero banner is 3:1 (components.BannerImage). On wide screens (lg+)
// it sits left with the video link and description beside it; on narrower
// screens the banner stays centred with the description below it.
//
// chartExerciseEntries is the most recent slice of exercise entries used to
// drive the line chart shown next to the stat cards. May be nil or short;
// the chart renders nothing when fewer than 2 unique calendar days are
// present.
//
// weightUnit is the user's preferred unit ("kg" / "lbs") and drives the
// strength stat-card values and the strength chart's dataset label.
// distanceUnit ("km" / "mi") drives the cardio equivalents. The exercise's
// own type decides which pair is used — a cardio exercise never shows
// weight-based stats even if the user's weight unit is set.
templ ExerciseHistory(exercise *models.Exercise, page *models.ExerciseHistoryPage, chartExerciseEntries []models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool, weightUnit string, distanceUnit string) {
	@views.Layout(views.PageData{Title: exercise.Name, UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="">
			<div class="flex items-center justify-between mb-2 gap-4">
				<div class="flex items-center gap-2">
					@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: exercise.Name})
					@components.ExerciseTypeBadge(string(exercise.Type), "hidden sm:flex")
				</div>
				<div class="flex items-center gap-2">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/exercises/%s/chart", exercise.ID)) }
						class="btn-outline"
					>
						@components.Icon(components.IconProps{Name: "trending-up", Size: 18})
					</a>
				</div>
			</div>
			<div class="hidden md:flex mb-4 flex-col gap-4 lg:flex-row lg:items-start">
				<div class="w-full lg:max-w-[624px]">
					if exercise.ImgURL != "" {
						<button type="button" class="w-full hover:cursor-pointer" onclick="document.getElementById('dialog-show-image').showModal()">
							@components.BannerImage(components.ImageProps{Src: utils.PublicURLFor(exercise.ImgURL), Alt: exercise.Name, Class: "max-w-[624px] mx-auto"})
						</button>
						<dialog id="dialog-show-image" class="dialog w-full sm:max-w-[425px] max-h-[612px]" aria-labelledby="demo-dialog-edit-profile-title" aria-describedby="demo-dialog-edit-profile-description" onclick="if (event.target === this) this.close()">
							<div class="max-h-full max-w-full" onclick="this.closest('dialog').close()">
								<button class="btn btn-secondary" onclick="this.closest('dialog').close()">X</button>
								<img src={ utils.PublicURLFor(exercise.ImgURL) } alt={ exercise.Name } class="w-full"/>
							</div>
						</dialog>
					} else {
						<div class="w-full aspect-[3/1] max-w-[624px] mx-auto bg-muted rounded-lg flex items-center justify-center">
							@components.Icon(components.IconProps{Name: "dumbbell", Size: 48})
						</div>
					}
				</div>
				<div class="card w-full min-w-0 lg:flex-1 p-4 flex flex-col items-start gap-4">
					if exercise.VideoURL != "" {
						<a href={ templ.SafeURL(exercise.VideoURL) } target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							@components.Icon(components.IconProps{Name: "play", Size: 18})
							Watch Video
						</a>
					}
					if exercise.Description != "" {
						<p class="text-muted-foreground">{ exercise.Description }</p>
					} else {
						<p class="text-muted-foreground text-sm">No description available</p>
					}
				</div>
			</div>
			<details class="flex md:hidden flex-col">
				<summary class="w-full focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] transition-all outline-none rounded-md">
					<h2 class="flex flex-1 items-start gap-4 py-2 text-left text-sm">
						More info
						<span class="text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200 group-open:rotate-180">
							@components.Icon(components.IconProps{Name: "arrow-down", Size: 18})
						</span>
					</h2>
				</summary>
				<section class="flex flex-col items-start gap-4 mb-2">
				if exercise.ImgURL != "" {
					<button type="button" class="w-full hover:cursor-pointer" onclick="document.getElementById('dialog-show-image').showModal()">
						@components.BannerImage(components.ImageProps{Src: utils.PublicURLFor(exercise.ImgURL), Alt: exercise.Name, Class: "max-w-[624px] mx-auto"})
					</button>
					<dialog id="dialog-show-image" class="dialog w-full sm:max-w-[425px] max-h-[612px]" aria-labelledby="demo-dialog-edit-profile-title" aria-describedby="demo-dialog-edit-profile-description" onclick="if (event.target === this) this.close()">
						<div class="max-h-full max-w-full" onclick="this.closest('dialog').close()">
							<button class="btn btn-secondary" onclick="this.closest('dialog').close()">X</button>
							<img src={ utils.PublicURLFor(exercise.ImgURL) } alt={ exercise.Name } class="w-full"/>
						</div>
					</dialog>
				} else {
					<div class="w-full aspect-[3/1] max-w-[624px] mx-auto bg-muted rounded-lg flex items-center justify-center">
						@components.Icon(components.IconProps{Name: "dumbbell", Size: 48})
					</div>
				}
					if exercise.VideoURL != "" {
						<a href={ templ.SafeURL(exercise.VideoURL) } target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							@components.Icon(components.IconProps{Name: "play", Size: 18})
							Watch Video
						</a>
					}
					if exercise.Description != "" {
						<p class="text-muted-foreground">{ exercise.Description }</p>
					} else {
						<p class="text-muted-foreground text-sm">No description available</p>
					}
				</section>
			</details>
		</div>
		if len(page.ExerciseEntries) == 0 {
			<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
				<header class="flex max-w-sm flex-col items-center gap-3 text-center">
					<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
						@components.Icon(components.IconProps{Name: "dumbbell", Size: 24})
					</div>
					@components.Title(components.TitleProps{Size: "md", Color: "default", Title: "No sets yet"})
					<p class="text-muted-foreground text-sm">You haven't logged any sets for { exercise.Name } yet.</p>
				</header>
			</div>
		} else {
			<div class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
				if exercise.Type == models.ExerciseTypeCardio {
					// Cardio exercises surface session-based stats: the most
					// recent workout (duration · distance) and the fastest
					// pace ever recorded, replacing the strength page's
					// "Last Set" / "Personal Best" weight cards.
					@components.StatCard(components.StatCardProps{Label: "Last Session", Value: lastSessionStatValue(page, distanceUnit)})
					@components.StatCard(components.StatCardProps{Label: "Best Pace", Value: bestPaceStatValue(page, distanceUnit)})
				} else {
					@components.StatCard(components.StatCardProps{Label: "Last Set", Value: models.FormatWeight(page.Stats.LastSet.Weight, weightUnit)})
					@components.StatCard(components.StatCardProps{Label: "Personal Best", Value: models.FormatWeight(page.Stats.MaxWeight, weightUnit)})
				}
				{{ chartProps := chartDataForExercise(chartExerciseEntries, exercise.Name, exercise.Type, weightUnit, distanceUnit) }}
				if len(chartProps.Labels) >= 2 {
					<div class="col-span-2 card p-2">
						<div class="h-28 sm:h-32 md:h-48">
							@components.Chart(chartProps)
						</div>
					</div>
				}
			</div>
			<h3 class="flex items-center gap-2 mb-4">
				@components.Icon(components.IconProps{Name: "dumbbell", Size: 20})
				History
			</h3>
			@HistoryTable(exercise, page, weightUnit, distanceUnit)
		}
	}
}

// HistoryTable renders the paginated exercise-entry table for a
// single exercise. Read-only on the web — editing a set happens in
// the iOS client.
//
// The metric columns follow the exercise's type: strength exercises
// show Reps / Weight, cardio exercises show Duration / Distance so a
// cardio row never renders a meaningless "0 × 0.0 kg".
//
// weightUnit and distanceUnit label the respective columns with the
// user's preferred units.
templ HistoryTable(exercise *models.Exercise, page *models.ExerciseHistoryPage, weightUnit string, distanceUnit string) {
	<div id={ historyTableWrapID } class="mb-4">
		<div class="overflow-x-auto">
			<table class="table">
				<thead>
					<tr>
						<th>Date</th>
						if exercise.Type == models.ExerciseTypeCardio {
							<th>Duration</th>
							<th>Distance</th>
						} else {
							<th>Reps</th>
							<th>Weight</th>
						}
						<th>Notes</th>
					</tr>
				</thead>
				<tbody>
					for _, exerciseEntry := range page.ExerciseEntries {
						<tr id={ fmt.Sprintf("exercise-entry-%s", exerciseEntry.ID) }>
							<td>{ exerciseEntry.FormattedDate() }</td>
							if exercise.Type == models.ExerciseTypeCardio {
								<td>{ models.FormatDuration(exerciseEntry.DurationSeconds) }</td>
								<td>{ exerciseEntry.FormattedDistance(distanceUnit) }</td>
							} else {
								<td>{ fmt.Sprintf("%d", exerciseEntry.Reps) }</td>
								<td>{ exerciseEntry.FormattedWeight(weightUnit) }</td>
							}
							<td>{ exerciseEntry.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<span id={ historySpinnerID } class="htmx-indicator flex items-center gap-2 text-sm text-muted-foreground mt-2">
			@components.Icon(components.IconProps{Name: "loader", Size: 16})
			Loading...
		</span>
		if page.HasPrev || page.HasNext {
			@components.Pagination(components.PaginationProps{
				HxGetBase: fmt.Sprintf("/exercises/%s", exercise.ID),
				Target:    historyTableWrapID,
				Indicator: historySpinnerID,
				Page:      page.Page,
				HasPrev:   page.HasPrev,
				HasNext:   page.HasNext,
			})
		}
	</div>
}

// lastSessionStatValue formats the "Last Session" stat card value for a
// cardio exercise: "25:00 · 5.20 km". Falls back to "—" when the user has
// no cardio exercise entries yet (the zero-value LastSet).
func lastSessionStatValue(page *models.ExerciseHistoryPage, distanceUnit string) string {
	if page.Stats.LastSet.ID == "" {
		return "—"
	}
	return fmt.Sprintf("%s · %s", models.FormatDuration(page.Stats.LastSet.DurationSeconds), page.Stats.LastSet.FormattedDistance(distanceUnit))
}

// bestPaceStatValue formats the "Best Pace" stat card value for a cardio
// exercise via the user's distance unit ("4:58 /km" / "8:01 /mi"). Falls
// back to "—" when no entry has both a duration and a distance.
func bestPaceStatValue(page *models.ExerciseHistoryPage, distanceUnit string) string {
	if pace := models.FormatPace(page.Stats.BestPaceSecPerKm, distanceUnit); pace != "" {
		return pace
	}
	return "—"
}

// chartDataForExercise converts a slice of recent exercise entries into the
// generic Chart props expected by components.Chart. Exercise entries are
// grouped by calendar day and reduced to one point per day so the line
// reads as a PR-over-time view (rather than a noisy per-set series):
// heaviest weight of the day for strength exercises, fastest pace of the
// day for cardio exercises. Days are sorted ascending so the line runs
// left-to-right.
//
// The chart's title reports how many raw exercise entries fed it (e.g.
// "Last 30 Sets" / "Last 30 Sessions") so the user can tell at a glance
// how much history the line represents. The chart component itself renders
// nothing when there are fewer than 2 labels.
//
// weightUnit and distanceUnit drive the dataset label so the legend matches
// the user's settings; exerciseType decides which metric is plotted.
func chartDataForExercise(exerciseEntries []models.ExerciseEntry, exerciseName string, exerciseType models.ExerciseType, weightUnit string, distanceUnit string) components.ChartProps {
	noun := "Sets"
	var days []chartDay
	if exerciseType == models.ExerciseTypeCardio {
		noun = "Sessions"
		days = aggregateExerciseEntriesPaceByDay(exerciseEntries)
	} else {
		days = aggregateExerciseEntriesByDay(exerciseEntries)
	}
	labels, values := dayLabelsAndValues(days, "02 Jan")
	return components.ChartProps{
		ID:     "exercise-history-chart",
		Title:  fmt.Sprintf("Last %d %s", len(exerciseEntries), noun),
		Labels: labels,
		Datasets: []components.ChartDataset{
			{Label: chartDatasetLabel(exerciseName, exerciseType, weightUnit, distanceUnit), Values: values},
		},
		// Hide the tick labels: the dates on x and the weight values on y would
		// overflow at this size. The y axis line and gridlines stay so the
		// line still has scale context, and tooltips still show exact values
		// on hover. The chart's own wrapper fills its parent; the view places
		// the chart in a sized inner wrapper inside the card.
		HideAxes: true,
	}
}
