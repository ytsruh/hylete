package admin

import (
	"fmt"
	"strings"

	"hylete/internal/models"
	"hylete/internal/utils"
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// AdminExerciseList renders the admin page listing all exercises.
templ AdminExerciseList(exercises []models.Exercise, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Admin - Exercises", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Exercises"})
			<a href="/admin/exercises/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				New Exercise
			</a>
		</div>
		<div class="mb-6">
			<input
				type="search"
				id="exercise-search"
				placeholder="Search exercises..."
				class="input"
			/>
		</div>
		if len(exercises) == 0 {
			<div class="text-center py-12 text-muted-foreground">
				<p>No exercises yet.</p>
			</div>
		} else {
			<table class="table w-full">
				<thead>
					<tr>
						<th>Name</th>
						<th>Type</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, e := range exercises {
						<tr class="exercise-row" data-name={ strings.ToLower(e.Name) }>
							<td>{ e.Name }</td>
							<td>
								@components.ExerciseTypeBadge(string(e.Type))
							</td>
							<td>
								<div class="flex gap-2">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/exercises/%s/edit", e.ID)) }
										class="btn-outline p-2"
										title="Edit"
									>
										@components.Icon(components.IconProps{Name: "edit", Size: 16})
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			<div id="no-results" class="hidden text-center py-12 text-muted-foreground">
				<p>No exercises found.</p>
			</div>
		}
		<script>
			(function() {
				const searchInput = document.getElementById('exercise-search');
				const rows = document.querySelectorAll('.exercise-row');
				const noResults = document.getElementById('no-results');
				let debounceTimer;

				searchInput.addEventListener('input', function() {
					clearTimeout(debounceTimer);
					debounceTimer = setTimeout(function() {
						const query = searchInput.value.toLowerCase().trim();
						let visibleCount = 0;

						rows.forEach(function(row) {
							const name = row.getAttribute('data-name');
							if (name.includes(query)) {
								row.classList.remove('hidden');
								visibleCount++;
							} else {
								row.classList.add('hidden');
							}
						});

						noResults.classList.toggle('hidden', visibleCount > 0);
					}, 200);
				});
			})();
		</script>
	}
}

// AdminExerciseFormData holds data for the exercise form.
type AdminExerciseFormData struct {
	Exercise *models.Exercise
	IsEdit   bool
}

// AdminExerciseForm renders a form for creating or editing an exercise.
templ AdminExerciseForm(data AdminExerciseFormData, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Admin - Exercises", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		if data.IsEdit {
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Edit Exercise"})
		} else {
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "New Exercise"})
		}
		if data.IsEdit {
			<form
				hx-post={ templ.SafeURL(fmt.Sprintf("/admin/exercises/%s", data.Exercise.ID)) }
				hx-target="#toaster"
				hx-swap="beforeend"
				class="form grid gap-6"
			>
				<fieldset class="grid gap-4">
					<div class="grid gap-2">
						<label for="name">Exercise Name</label>
						<input
							class="input"
							type="text"
							id="name"
							name="name"
							placeholder="e.g. Bench Press"
							value={ data.Exercise.Name }
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="type">Type</label>
						<select class="input" id="type" name="type">
							<option value="strength" selected?={ string(data.Exercise.Type) == "strength" }>Strength</option>
							<option value="cardio" selected?={ string(data.Exercise.Type) == "cardio" }>Cardio</option>
							<option value="other" selected?={ string(data.Exercise.Type) == "other" }>Other</option>
						</select>
					</div>
					<div class="grid gap-2">
						<label for="description">Description</label>
						<textarea
							class="input"
							id="description"
							name="description"
							placeholder="Brief description of the exercise"
							rows="3"
						>{ data.Exercise.Description }</textarea>
					</div>
					<div class="grid gap-2">
						<label for="video_url">Video URL</label>
						<input
							class="input"
							type="url"
							id="video_url"
							name="video_url"
							placeholder="https://example.com/video.mp4"
							value={ data.Exercise.VideoURL }
						/>
					</div>
					@components.ImageUpload(components.ImageUploadProps{
						Name:               "exercise",
						Label:              "Image",
						CurrentURL:         utils.PublicURLFor(data.Exercise.ImgURL),
						CurrentKey:         data.Exercise.ImgURL,
						CurrentOriginalKey: data.Exercise.ImgURLOriginal,
						MaxSizeMB:          10,
						UploadEndpoint:     "/admin/exercises/image-upload",
						RemoveFieldName:    "clear_image",
						RemoveLabel:        "Remove current image",
						AspectWidth:        3,
						AspectHeight:       1,
					})
				</fieldset>
				<div class="flex gap-3">
					<button type="submit" hx-indicator="#edit-exercise-spinner" class="btn relative inline-flex">
						<span class="btn-text flex items-center justify-around gap-2">
							@components.Icon(components.IconProps{Name: "check", Size: 18})
							Update
						</span>
						<span id="edit-exercise-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
							@components.Icon(components.IconProps{Name: "loader", Size: 18})
						</span>
					</button>
					<a href="/admin/exercises" class="btn-outline">
						@components.Icon(components.IconProps{Name: "x", Size: 18})
						Cancel
					</a>
				</div>
			</form>
		} else {
			<form
				hx-post="/admin/exercises"
				hx-target="#toaster"
				hx-swap="beforeend"
				class="form grid gap-6"
			>
				<fieldset class="grid gap-4">
					<div class="grid gap-2">
						<label for="name">Exercise Name</label>
						<input
							class="input"
							type="text"
							id="name"
							name="name"
							placeholder="e.g. Bench Press"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="type">Type</label>
						<select class="input" id="type" name="type">
							<option value="strength">Strength</option>
							<option value="cardio">Cardio</option>
							<option value="other" selected>Other</option>
						</select>
					</div>
					<div class="grid gap-2">
						<label for="description">Description</label>
						<textarea
							class="input"
							id="description"
							name="description"
							placeholder="Brief description of the exercise"
							rows="3"
						></textarea>
					</div>
					<div class="grid gap-2">
						<label for="video_url">Video URL</label>
						<input
							class="input"
							type="url"
							id="video_url"
							name="video_url"
							placeholder="https://example.com/video.mp4"
						/>
					</div>
					@components.ImageUpload(components.ImageUploadProps{
						Name:           "exercise",
						Label:          "Image",
						MaxSizeMB:      10,
						UploadEndpoint: "/admin/exercises/image-upload",
						AspectWidth:    3,
						AspectHeight:   1,
					})
				</fieldset>
				<div class="flex gap-3">
					<button type="submit" hx-indicator="#new-exercise-spinner" class="btn relative inline-flex">
						<span class="btn-text flex items-center justify-around gap-2">
							@components.Icon(components.IconProps{Name: "check", Size: 18})
							Save
						</span>
						<span id="new-exercise-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
							@components.Icon(components.IconProps{Name: "loader", Size: 18})
						</span>
					</button>
					<a href="/admin/exercises" class="btn-outline">
						@components.Icon(components.IconProps{Name: "x", Size: 18})
						Cancel
					</a>
				</div>
			</form>
		}
	}
}

// AdminExerciseFormError shows validation errors for the exercise form.
templ AdminExerciseFormError(message string) {
	@views.Toast("error", "Error", message)
}

// AdminExerciseSuccessToast returns only the toast (for HTMX responses)
templ AdminExerciseSuccessToast(message string) {
	@views.Toast("success", "Success", message)
}
