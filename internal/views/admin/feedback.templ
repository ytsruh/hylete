package admin

import (
	"fmt"

	"hylete/internal/models"
	"hylete/internal/views"
	"hylete/internal/views/components"
)

// AdminFeedbackList renders the admin page listing feedback with
// Open / Closed / All filter buttons. The default view (no filter
// query param) shows only open feedback.
templ AdminFeedbackList(feedback []*models.Feedback, filter string, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Admin - Feedback", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Feedback"})
		</div>
		<div class="flex gap-2 mb-6">
			<a
				href="/admin/feedback?filter=open"
				class={ getFilterBtnClass(filter, "open") }
			>
				Open
			</a>
			<a
				href="/admin/feedback?filter=closed"
				class={ getFilterBtnClass(filter, "closed") }
			>
				Closed
			</a>
			<a
				href="/admin/feedback?filter=all"
				class={ getFilterBtnClass(filter, "all") }
			>
				All
			</a>
		</div>
		if len(feedback) == 0 {
			<div class="card p-6 text-center">
				<p class="text-muted-foreground">No feedback found</p>
			</div>
		} else {
			<div class="card overflow-hidden">
				<table class="table">
					<thead>
						<tr>
							<th>Title</th>
							<th class="hidden sm:table-cell">Submitted By</th>
							<th class="hidden sm:table-cell">Date</th>
							<th>Status</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, f := range feedback {
							<tr>
								<td class="font-medium truncate max-w-37.5 sm:max-w-75">{ f.Title }</td>
								<td class="hidden sm:table-cell">{ f.UserName }</td>
								<td class="text-muted-foreground hidden sm:table-cell">{ f.CreatedAt.Format("02 Jan 2006") }</td>
								<td>
									if f.IsClosed {
										<span class="badge badge-secondary">Closed</span>
									} else {
										<span class="badge">Open</span>
									}
								</td>
								<td>
									<a href={ templ.URL(fmt.Sprintf("/admin/feedback/%s", f.ID)) } class="btn-outline text-sm py-1">
										View
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// AdminFeedbackDetail renders the read-only detail view for a single
// feedback item, with a Close / Reopen action button.
templ AdminFeedbackDetail(feedback *models.Feedback, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Admin - Feedback Detail", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<a href="/admin/feedback" class="btn-outline mb-4 ">
			<span class="flex items-center gap-2">
				@components.Icon(components.IconProps{Name: "chevron-left", Size: 18})
				Back
			</span>
		</a>
		<form class="">
			<fieldset class="grid gap-4">
				<div class="grid gap-2">
					<label for="submitted-by">Submitted By</label>
					<input
						class="input bg-muted"
						type="text"
						id="submitted-by"
						value={ feedback.UserName }
						disabled
					/>
				</div>
				<div class="grid gap-2">
					<label for="date">Date</label>
					<input
						class="input bg-muted"
						type="text"
						id="date"
						value={ feedback.CreatedAt.Format("02 January 2006 at 15:04") }
						disabled
					/>
				</div>
				<div class="grid gap-2">
					<label for="title">Title</label>
					<input
						class="input bg-muted"
						type="text"
						id="title"
						value={ feedback.Title }
						disabled
					/>
				</div>
				<div class="grid gap-2">
					<label for="message">Message</label>
					<textarea
						class="textarea bg-muted"
						id="message"
						rows="6"
						disabled
					>{ feedback.Message }</textarea>
				</div>
				<div class="grid gap-2">
					<label for="status">Status</label>
					<input
						class="input bg-muted"
						type="text"
						id="status"
						if feedback.IsClosed {
							value="Closed"
						} else {
							value="Open"
						}
						disabled
					/>
				</div>
			</fieldset>
			<div class="flex gap-3 py-5 justify-between">
				<button
					type="button"
					hx-post={ fmt.Sprintf("/admin/feedback/%s/close", feedback.ID) }
					hx-indicator="#close-spinner"
					hx-target="#toaster"
					hx-swap="beforeend"
					class="btn relative inline-flex"
				>
					<span class="btn-text flex items-center gap-2">
						if feedback.IsClosed {
							@components.Icon(components.IconProps{Name: "undo", Size: 18})
							Reopen
						} else {
							@components.Icon(components.IconProps{Name: "check", Size: 18})
							Close
						}
					</span>
					<span id="close-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
			</div>
		</form>
		// Page-scoped success handler: the POST response carries an
		// HX-Trigger for this event once the status has been updated.
		// The confirmation toast is appended to #toaster by htmx, so
		// we give it a moment to be seen before sending the admin
		// back to the feedback list. Scoped to this page rather than
		// the global layout because only the detail view performs a
		// status update.
		<script>
			document.body.addEventListener('feedbackStatusUpdated', function() {
				setTimeout(function() {
					window.location.href = '/admin/feedback';
				}, 1000);
			});
		</script>
	}
}

// AdminFeedbackClosedSuccess is the toast returned to HTMX after a
// close / reopen action succeeds.
templ AdminFeedbackClosedSuccess() {
	@views.Toast("success", "Feedback status updated", "")
}

// getFilterBtnClass returns the button class for the filter pill that
// matches the current filter; non-active pills use the outline variant.
func getFilterBtnClass(currentFilter, targetFilter string) string {
	if currentFilter == targetFilter {
		return "btn"
	}
	return "btn-outline"
}
