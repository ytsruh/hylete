package emailtmpl

import "time"

// PasswordResetEmail is the HTML body of the "reset your password"
// email. The TTL is rendered in plain English ("1 hour") inside
// the copy so the reader knows the deadline without having to
// decode the URL or count characters.
//
// The reset URL is the only secret material in the email. Every
// other piece (the app name, the "if you didn't ask" caveat) is
// identical between legitimate sends and potential phishing
// attempts, so the email deliberately does not include the user's
// account email address — that would let an attacker confirm
// that the address they sent the reset to belongs to a real
// user. The copy instead refers to "your Hylete account".
//
// The baseURL is threaded into the footer's "view on the web"
// link so a staging deployment sends email that points at
// itself, not at production.
templ PasswordResetEmail(name, resetURL, baseURL string, ttl time.Duration) {
	@EmailLayout("Reset your Hylete password.") {
		@EmailHeader()
		<div style="padding:24px 0 8px 0;">
			@EmailTitle("Reset your password")
			@EmailParagraph("Hi " + name + ", we received a request to reset the password on your Hylete account.")
			@EmailParagraph("Click the button below within " + humanizeTTL(ttl) + ". After that the link will stop working and you can request a new one from the forgot-password page.")
			@EmailButton(resetURL, "Reset your password")
			@EmailMutedParagraph("If you didn't ask for this, you can safely ignore this email — your password will not change until you click the link above and choose a new one.")
		</div>
		@EmailDivider()
		@EmailFooter(CurrentYear(), baseURL)
	}
}
