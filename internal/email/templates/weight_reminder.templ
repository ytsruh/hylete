package emailtmpl

// WeightReminderEmail is the HTML body of the per-user "time to
// log your weight" reminder. Reminders are email-only, so this
// template IS the reminder: the call-to-action is to tap the
// button, land on /weight/new, log the reading, optionally upload
// a photo.
//
// The cadence is rendered into the title and the header blurb so
// a daily subscriber gets "Today's weigh-in" and a weekly
// subscriber gets "Weekly weigh-in reminder" (etc.) — the same
// template serves every frequency, so adding a new cadence is a
// one-line change in reminderCadenceCopy rather than a new templ
// file. The copy is deliberately day-agnostic: a weekly reminder
// fires on whichever weekday the user picked, so no email text
// names a specific day or time.
//
// The baseURL is threaded through so a staging deployment sends
// an email that points at itself, not at production.
templ WeightReminderEmail(name string, baseURL string, subject string, header string) {
	@EmailLayout(header) {
		@EmailHeader()
		<div style="padding:24px 0 8px 0;">
			@EmailTitle(subject)
			@EmailParagraph("Hi " + name + ", it's time to log your weight.")
			@EmailParagraph(reminderBodyBlurb(subject))
			@EmailButton(baseURL+"/weight/new", reminderButtonLabel(subject))
		</div>
		@EmailDivider()
		@EmailFooter(CurrentYear(), baseURL)
	}
}

// reminderBodyBlurb returns the second-paragraph blurb for the
// email. Pulled into a function (rather than inlined into the
// templ) so the cadence-specific copy lives next to the
// cadence-specific subject and button label in render.go. The
// caller passes the subject, not the cadence, so the templ
// component stays a dumb renderer.
func reminderBodyBlurb(subject string) string {
	switch subject {
	case "Weekly weigh-in reminder":
		return "A single entry a week is the most reliable way to spot a trend without making the scale a daily event. Tap below to add this week's reading — and feel free to add a photo if you want to see your progress over time."
	case "Time to log your weight":
		return "A quick reading keeps your trend line honest. Tap below to add today's entry — and feel free to add a photo if you want to see your progress over time."
	}
	return "Tap below to add today's reading."
}

// reminderButtonLabel returns the call-to-action label that
// shows on the email's big button. Mirrors the cadence-specific
// phrasing so a daily user sees "Log today's weight" and a
// weekly user sees "Log this week's weight".
func reminderButtonLabel(subject string) string {
	switch subject {
	case "Weekly weigh-in reminder":
		return "Log this week's weight"
	case "Time to log your weight":
		return "Log today's weight"
	}
	return "Log your weight"
}
